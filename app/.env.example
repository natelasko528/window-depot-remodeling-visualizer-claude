# ─── Rendering (server-side only, never exposed to the browser) ───────────────
# Produces the "after" image. Claude cannot generate images, so this stays OpenAI.
OPENAI_API_KEY=sk-...

# Exact image model id from your OpenAI dashboard.
OPENAI_IMAGE_MODEL=gpt-image-1

# Fallback only. The size is normally derived from the photograph so the render
# comes back in the same frame as the original; this is used when a photo's
# dimensions cannot be read.
OPENAI_IMAGE_SIZE=1536x1024

# ─── Surface detection (server-side only) ─────────────────────────────────────
# Claude reads the photo and returns the roof / siding / window regions.
# Without this the app still works — areas are marked by hand instead.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5

# ─── Sync (these reach the browser by design — anon key only) ─────────────────
# Optional. Without them the app runs local-only: everything is saved on the
# tablet and nothing syncs to the cloud.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
